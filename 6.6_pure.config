# ====================================================
# 1. 目标硬件与架构配置 (360T7 / MT7981)
# ====================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# ====================================================
# 2. LuCI Web 界面、中文语言包与主题
# ====================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y

# ====================================================
# 3. 首页 CPU / Wi-Fi 实时温度显示扩展
# ====================================================
CONFIG_PACKAGE_luci-app-temp-status=y

# ====================================================
# 4. MTK 闭源无线驱动 & 802.11r/k/v 无缝漫游组件
# ====================================================
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
# CONFIG_PACKAGE_wpad-basic-openssl is not set
CONFIG_PACKAGE_wpad-openssl=y

# ====================================================
# 5. MTK 芯片级硬件加速 (HNAT & TurboACC)
# ====================================================
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y

# ====================================================
# 6. 精简实用扩展组件（终端、UPnP、ARP绑定、定时重启）
# ====================================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# ====================================================
# 7. 基础网络与系统工具 (包含完整 IPv6 支持)
# ====================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# CONFIG_PACKAGE_kmod-mtk-conninfra is not set
# CONFIG_PACKAGE_luci-app-mtk-conninfra is not set
CONFIG_PACKAGE_zram-swap=y
